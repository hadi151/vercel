const CATEGORIES = ['All', 'Electronics', 'Audio', 'Furniture', 'Home & Living', 'Lifestyle'];

export default function App() {
  // Store state persist simulated with state
  const [products, setProducts] = useState(INITIAL_PRODUCTS);
  const [cart, setCart] = useState([]);
  const [isCartOpen, setIsCartOpen] = useState(false);
  const [selectedProduct, setSelectedProduct] = useState(null);
  const [activeCategory, setActiveCategory] = useState('All');
  const [searchQuery, setSearchQuery] = useState('');
  const [viewMode, setViewMode] = useState('store'); // 'store' | 'admin' | 'checkout' | 'order-success'
  const [wishlist, setWishlist] = useState([]);
  const [lastOrder, setLastOrder] = useState(null);
  const [orders, setOrders] = useState([
    {
      id: 'ORD-9482',
      date: '2026-03-28',
      customer: 'Alex Rivera',
      email: 'alex.rivera@example.com',
      total: 488.99,
      status: 'Delivered',
      itemsCount: 2
    },
    {
      id: 'ORD-8391',
      date: '2026-03-30',
      customer: 'Sophia Chen',
      email: 'sophia.c@example.com',
      total: 189.99,
      status: 'Processing',
      itemsCount: 1
    }
  ]);

  // Admin Form State
  const [editingProduct, setEditingProduct] = useState(null);
  const [productForm, setProductForm] = useState({
    name: '',
    category: 'Electronics',
    price: '',
    originalPrice: '',
    description: '',
    images: [''],
    stock: '',
    isFeatured: false,
    isNew: false
  });

  // Filter products by search and category
  const filteredProducts = useMemo(() => {
    return products.filter(product => {
      const matchesCategory = activeCategory === 'All' || product.category === activeCategory;
      const matchesSearch = product.name.toLowerCase().includes(searchQuery.toLowerCase()) || 
                            product.description.toLowerCase().includes(searchQuery.toLowerCase()) ||
                            product.category.toLowerCase().includes(searchQuery.toLowerCase());
      return matchesCategory && matchesSearch;
    });
  }, [products, activeCategory, searchQuery]);

  // Cart Calculations
  const cartSubtotal = useMemo(() => {
    return cart.reduce((acc, item) => acc + (item.price * item.quantity), 0);
  }, [cart]);

  const cartItemsCount = useMemo(() => {
    return cart.reduce((acc, item) => acc + item.quantity, 0);
  }, [cart]);

  // Add to Cart Logic
  const handleAddToCart = (product, selectedColor = null, selectedSize = null, qty = 1) => {
    const color = selectedColor || product.colorNames[0] || 'Default';
    const size = selectedSize || product.sizes[0] || 'Standard';
    const cartItemId = `${product.id}-${color}-${size}`;

    setCart(prevCart => {
      const existingIndex = prevCart.findIndex(item => item.cartItemId === cartItemId);
      if (existingIndex > -1) {
        const updated = [...prevCart];
        updated[existingIndex].quantity += qty;
        return updated;
      } else {
        return [...prevCart, {
          ...product,
          cartItemId,
          selectedColor: color,
          selectedSize: size,
          quantity: qty
        }];
      }
    });
    setIsCartOpen(true);
  };

  // Cart Quantity Updates
  const updateQuantity = (cartItemId, delta) => {
    setCart(prevCart => {
      return prevCart.map(item => {
        if (item.cartItemId === cartItemId) {
          const newQty = item.quantity + delta;
          return newQty > 0 ? { ...item, quantity: newQty } : null;
        }
        return item;
      }).filter(Boolean);
    });
  };

  const removeFromCart = (cartItemId) => {
    setCart(prevCart => prevCart.filter(item => item.cartItemId !== cartItemId));
  };

  const toggleWishlist = (productId) => {
    setWishlist(prev => 
      prev.includes(productId) ? prev.filter(id => id !== productId) : [...prev, productId]
    );
  };

  // Product Admin Actions
  const handleSaveProduct = (e) => {
    e.preventDefault();
    if (!productForm.name || !productForm.price) return;

    const newProd = {
      id: editingProduct ? editingProduct.id : `prod-${Date.now()}`,
      name: productForm.name,
      category: productForm.category,
      price: parseFloat(productForm.price),
      originalPrice: productForm.originalPrice ? parseFloat(productForm.originalPrice) : parseFloat(productForm.price) * 1.15,
      rating: editingProduct ? editingProduct.rating : 5.0,
      reviewsCount: editingProduct ? editingProduct.reviewsCount : 1,
      isNew: productForm.isNew,
      isFeatured: productForm.isFeatured,
      description: productForm.description || 'Premium engineered modern lifestyle item.',
      images: productForm.images[0] ? productForm.images : ['https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?auto=format&fit=crop&w=800&q=80'],
      colors: ['#0f172a', '#e2e8f0'],
      colorNames: ['Default Tone'],
      sizes: ['Standard'],
      stock: parseInt(productForm.stock) || 10,
      tags: ['New Arrival']
    };

    if (editingProduct) {
      setProducts(prev => prev.map(p => p.id === editingProduct.id ? newProd : p));
    } else {
      setProducts(prev => [newProd, ...prev]);
    }

    // Reset Form
    setEditingProduct(null);
    setProductForm({
      name: '', category: 'Electronics', price: '', originalPrice: '', description: '', images: [''], stock: '', isFeatured: false, isNew: false
    });
  };

  const handleDeleteProduct = (id) => {
    setProducts(prev => prev.filter(p => p.id !== id));
  };

  const startEditProduct = (prod) => {
    setEditingProduct(prod);
    setProductForm({
      name: prod.name,
      category: prod.category,
      price: prod.price.toString(),
      originalPrice: prod.originalPrice ? prod.originalPrice.toString() : '',
      description: prod.description,
      images: prod.images,
      stock: prod.stock.toString(),
      isFeatured: prod.isFeatured,
      isNew: prod.isNew
    });
  };

  // Order Placement
  const handleCheckoutSubmit = (formData) => {
    const newOrder = {
      id: `ORD-${Math.floor(1000 + Math.random() * 9000)}`,
      date: new Date().toISOString().split('T')[0],
      customer: `${formData.firstName} ${formData.lastName}`,
      email: formData.email,
      total: cartSubtotal + (cartSubtotal > 150 ? 0 : 15.00),
      status: 'Processing',
      itemsCount: cartItemsCount,
      items: cart
    };

    setOrders([newOrder, ...orders]);
    setLastOrder(newOrder);
    setCart([]);
    setViewMode('order-success');
  };

  return (
    <div className="min-h-screen bg-slate-900 text-slate-100 font-sans flex flex-col selection:bg-indigo-500 selection:text-white">
      {/* --- TOP BANNER --- */}
      <div className="bg-gradient-to-r from-indigo-600 via-purple-600 to-indigo-600 text-white text-xs py-2 px-4 text-center font-medium tracking-wide flex justify-center items-center gap-2">
        <Sparkles size={14} className="animate-pulse" />
        <span>Spring Collection Unveiled: Free Express Delivery on Orders Over $150</span>
        <span className="hidden sm:inline bg-white/20 rounded-full px-2 py-0.5 text-[10px] uppercase font-bold tracking-wider">Use: AURA2026</span>
      </div>

      {/* --- HEADER NAVBAR --- */}
      <header className="sticky top-0 z-40 bg-slate-900/90 backdrop-blur-md border-b border-slate-800 transition-all">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
          
          {/* Logo */}
          <div className="flex items-center gap-8">
            <button 
              onClick={() => setViewMode('store')} 
              className="text-2xl font-black tracking-tighter bg-gradient-to-r from-indigo-400 via-purple-300 to-pink-400 bg-clip-text text-transparent flex items-center gap-2 hover:opacity-90 transition"
            >
              <div className="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center text-white font-black text-lg shadow-lg shadow-indigo-500/30">A</div>
              <span>AURA</span>
            </button>

            {/* Desktop Navigation */}
            <nav className="hidden md:flex items-center gap-6 text-sm font-medium text-slate-300">
              <button 
                onClick={() => { setViewMode('store'); setActiveCategory('All'); }}
                className={`hover:text-indigo-400 transition ${viewMode === 'store' && activeCategory === 'All' ? 'text-indigo-400 font-semibold' : ''}`}
              >
                Shop All
              </button>
              <button 
                onClick={() => { setViewMode('store'); setActiveCategory('Electronics'); }}
                className={`hover:text-indigo-400 transition ${activeCategory === 'Electronics' ? 'text-indigo-400 font-semibold' : ''}`}
              >
                Electronics
              </button>
              <button 
                onClick={() => { setViewMode('store'); setActiveCategory('Audio'); }}
                className={`hover:text-indigo-400 transition ${activeCategory === 'Audio' ? 'text-indigo-400 font-semibold' : ''}`}
              >
                Audio
              </button>
              <button 
                onClick={() => { setViewMode('store'); setActiveCategory('Furniture'); }}
                className={`hover:text-indigo-400 transition ${activeCategory === 'Furniture' ? 'text-indigo-400 font-semibold' : ''}`}
              >
                Furniture
              </button>
            </nav>
          </div>

          {/* Search Bar */}
          <div className="flex-1 max-w-md hidden sm:block">
            <div className="relative">
              <Search className="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400" size={18} />
              <input 
                type="text"
                placeholder="Search products, brands, categories..."
                value={searchQuery}
                onChange={(e) => setSearchQuery(e.target.value)}
                className="w-full bg-slate-800/80 border border-slate-700/80 rounded-full pl-10 pr-4 py-2 text-sm text-slate-100 placeholder-slate-400 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition"
              />
              {searchQuery && (
                <button 
                  onClick={() => setSearchQuery('')}
                  className="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-white"
                >
                  <X size={14} />
                </button>
              )}
            </div>
          </div>

          {/* Right Action Icons */}
          <div className="flex items-center gap-3 sm:gap-4">
            {/* View Mode Toggle: Admin Dashboard */}
            <button
              onClick={() => setViewMode(viewMode === 'admin' ? 'store' : 'admin')}
              className={`flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-semibold border transition ${
                viewMode === 'admin'
                  ? 'bg-indigo-600 text-white border-indigo-500 shadow-lg shadow-indigo-500/20'
                  : 'bg-slate-800 text-slate-300 border-slate-700 hover:bg-slate-700 hover:text-white'
              }`}
            >
              <LayoutDashboard size={16} />
              <span className="hidden sm:inline">{viewMode === 'admin' ? 'Storefront' : 'Admin Portal'}</span>
            </button>

            {/* Cart Button */}
            <button
              onClick={() => setIsCartOpen(true)}
              className="relative p-2.5 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-full border border-slate-700 transition"
              aria-label="View Shopping Cart"
            >
              <ShoppingBag size={20} />
              {cartItemsCount > 0 && (
                <span className="absolute -top-1 -right-1 bg-gradient-to-r from-pink-500 to-indigo-500 text-white font-bold text-[10px] w-5 h-5 rounded-full flex items-center justify-center border-2 border-slate-900 shadow">
                  {cartItemsCount}
                </span>
              )}
            </button>
          </div>
        </div>

        {/* Mobile Search Bar */}
        <div className="sm:hidden px-4 pb-3">
          <div className="relative">
            <Search className="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" size={16} />
            <input 
              type="text"
              placeholder="Search store..."
              value={searchQuery}
              onChange={(e) => setSearchQuery(e.target.value)}
              className="w-full bg-slate-800 border border-slate-700 rounded-lg pl-9 pr-4 py-2 text-sm text-slate-100 placeholder-slate-400 focus:outline-none focus:border-indigo-500"
            />
          </div>
        </div>
      </header>

      {/* --- MAIN CONTENT SWITCHER --- */}
      <main className="flex-grow">
        {viewMode === 'store' && (
          <StorefrontView 
            products={filteredProducts}
            categories={CATEGORIES}
            activeCategory={activeCategory}
            setActiveCategory={setActiveCategory}
            onSelectProduct={setSelectedProduct}
            onAddToCart={handleAddToCart}
            wishlist={wishlist}
            toggleWishlist={toggleWishlist}
            searchQuery={searchQuery}
          />
        )}

        {viewMode === 'admin' && (
          <AdminDashboardView 
            products={products}
            orders={orders}
            editingProduct={editingProduct}
            productForm={productForm}
            setProductForm={setProductForm}
            handleSaveProduct={handleSaveProduct}
            startEditProduct={startEditProduct}
            handleDeleteProduct={handleDeleteProduct}
            setEditingProduct={setEditingProduct}
          />
        )}

        {viewMode === 'checkout' && (
          <CheckoutView 
            cart={cart}
            cartSubtotal={cartSubtotal}
            onBackToStore={() => setViewMode('store')}
            onSubmitOrder={handleCheckoutSubmit}
          />
        )}

        {viewMode === 'order-success' && (
          <OrderSuccessView 
            order={lastOrder}
            onContinueShopping={() => setViewMode('store')}
          />
        )}
      </main>

      {/* --- SHOPPING CART DRAWER --- */}
      {isCartOpen && (
        <div className="fixed inset-0 z-50 flex justify-end">
          <div 
            className="fixed inset-0 bg-slate-950/70 backdrop-blur-sm transition-opacity"
            onClick={() => setIsCartOpen(false)}
          />
          <div className="relative w-full max-w-md bg-slate-900 border-l border-slate-800 h-full shadow-2xl flex flex-col z-10">
            {/* Cart Header */}
            <div className="p-6 border-b border-slate-800 flex items-center justify-between">
              <div className="flex items-center gap-3">
                <ShoppingBag className="text-indigo-400" size={24} />
                <h2 className="text-xl font-bold text-white">Your Cart</h2>
                <span className="text-xs bg-slate-800 text-slate-400 px-2 py-0.5 rounded-full font-medium">
                  {cartItemsCount} {cartItemsCount === 1 ? 'item' : 'items'}
                </span>
              </div>
              <button 
                onClick={() => setIsCartOpen(false)}
                className="p-1 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition"
              >
                <X size={20} />
              </button>
            </div>

            {/* Cart Items List */}
            <div className="flex-1 overflow-y-auto p-6 space-y-4">
              {cart.length === 0 ? (
                <div className="h-full flex flex-col items-center justify-center text-center p-6 text-slate-500">
                  <ShoppingBasket size={64} className="mb-4 stroke-1 text-slate-600" />
                  <p className="text-lg font-semibold text-slate-300 mb-1">Your cart is empty</p>
                  <p className="text-sm max-w-xs mb-6">Looks like you haven't added anything to your cart yet.</p>
                  <button
                    onClick={() => setIsCartOpen(false)}
                    className="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold rounded-xl transition"
                  >
                    Start Shopping
                  </button>
                </div>
              ) : (
                cart.map((item) => (
                  <div 
                    key={item.cartItemId} 
                    className="flex gap-4 p-4 bg-slate-800/50 border border-slate-800 rounded-2xl relative group hover:border-slate-700 transition"
                  >
                    <img 
                      src={item.images[0]} 
                      alt={item.name} 
                      className="w-20 h-20 object-cover rounded-xl bg-slate-800"
                    />
                    <div className="flex-1 flex flex-col justify-between">
                      <div>
                        <div className="flex justify-between items-start gap-2">
                          <h3 className="text-sm font-semibold text-white leading-tight line-clamp-1">{item.name}</h3>
                          <button 
                            onClick={() => removeFromCart(item.cartItemId)}
                            className="text-slate-500 hover:text-red-400 transition"
                          >
                            <Trash2 size={16} />
                          </button>
                        </div>
                        <div className="text-xs text-slate-400 mt-1 space-x-2">
                          <span>Variant: {item.selectedColor}</span>
                          <span>•</span>
                          <span>{item.selectedSize}</span>
                        </div>
                      </div>

                      <div className="flex items-center justify-between mt-3">
                        <span className="font-bold text-indigo-400 text-sm">
                          ${(item.price * item.quantity).toFixed(2)}
                        </span>
                        
                        {/* Quantity Controls */}
                        <div className="flex items-center border border-slate-700 rounded-lg bg-slate-900">
                          <button 
                            onClick={() => updateQuantity(item.cartItemId, -1)}
                            className="p-1 text-slate-400 hover:text-white transition"
                          >
                            <Minus size={14} />
                          </button>
                          <span className="px-2.5 text-xs font-semibold text-slate-200">
                            {item.quantity}
                          </span>
                          <button 
                            onClick={() => updateQuantity(item.cartItemId, 1)}
                            className="p-1 text-slate-400 hover:text-white transition"
                          >
                            <Plus size={14} />
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                ))
              )}
            </div>

            {/* Cart Footer */}
            {cart.length > 0 && (
              <div className="p-6 border-t border-slate-800 bg-slate-900/90 space-y-4">
                <div className="space-y-2">
                  <div className="flex justify-between text-sm text-slate-400">
                    <span>Subtotal</span>
                    <span className="text-slate-200 font-semibold">${cartSubtotal.toFixed(2)}</span>
                  </div>
                  <div className="flex justify-between text-sm text-slate-400">
                    <span>Estimated Shipping</span>
                    <span className="text-emerald-400 font-medium">
                      {cartSubtotal >= 150 ? 'FREE' : '$15.00'}
                    </span>
                  </div>
                  <div className="pt-2 border-t border-slate-800 flex justify-between text-base font-bold text-white">
                    <span>Total</span>
                    <span className="text-indigo-400">
                      ${(cartSubtotal + (cartSubtotal >= 150 ? 0 : 15)).toFixed(2)}
                    </span>
                  </div>
                </div>

                <button
                  onClick={() => {
                    setIsCartOpen(false);
                    setViewMode('checkout');
                  }}
                  className="w-full py-3.5 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold rounded-xl transition flex items-center justify-center gap-2 shadow-lg shadow-indigo-600/30"
                >
                  <span>Proceed to Checkout</span>
                  <ArrowRight size={18} />
                </button>
              </div>
            )}
          </div>
        </div>
      )}

      {/* --- PRODUCT DETAIL MODAL --- */}
      {selectedProduct && (
